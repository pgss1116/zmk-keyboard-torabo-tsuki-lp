#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define JP_YEN          0x89              // ¥
#define JP_PIPE         LS(0x89)          // |
#define JP_UNDERSCORE   LS(0x87)          // _

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <25 26>;
        };

        combo_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <39 40>;
        };

        combo_mb1 {
            bindings = <&mkp MB1>;
            key-positions = <33 34>;
        };

        combo_mb2 {
            bindings = <&mkp MB2>;
            key-positions = <35 36>;
        };

        combo_mb3 {
            bindings = <&mkp MB3>;
            key-positions = <35 34>;
        };

        combo_mb4 {
            bindings = <&mkp MB4>;
            key-positions = <47 48>;
        };

        combo_mb5 {
            bindings = <&mkp MB5>;
            key-positions = <19 20>;
        };

        combo_tab2 {
            bindings = <&kp TAB>;
            key-positions = <35 36>;
        };

        combo_alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <57 54>;
        };

        combo_win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <60 63>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none  &none  &none         &none         &none                                &none                     &none    &none      &none    &none      &none
&none  &kp Q  &kp W  &kp E         &kp R         &kp T                                &kp Y                     &kp U    &kp I      &kp O    &kp P      &none
&none  &kp A  &kp S  &lt 2 D       &lt 1 F       &kp G      &mkp LCLK    &mkp RCLK    &kp H                     &lt 1 J  &lt 2 K    &kp L    &kp SEMI   &none
&none  &kp Z  &kp X  &kp C         &kp V         &kp B      &kp SPACE    &kp RET      &kp N                     &kp M    &kp COMMA  &kp DOT  &kp SLASH  &none
&none  &none  &none  &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &lt 3 SPACE  &lt 3 ENTER  &mt LEFT_SHIFT BACKSPACE  &none    &none      &none    &none      &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans    &trans        &trans     &trans                  &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans  &trans    &kp UP_ARROW  &trans     &trans                  &trans  &kp N7  &kp N8  &kp N9  &kp DELETE  &trans
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &kp INS     &trans
&trans  &trans  &trans    &trans        &trans     &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans      &trans
&trans  &trans  &trans    &trans        &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans    &trans         &trans   &trans                  &trans  &trans   &trans  &trans  &trans  &trans
&trans  &trans  &trans    &kp PG_UP      &trans   &trans                  &trans  &kp F7   &kp F8  &kp F9  &trans  &trans
&trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp END  &trans  &trans  &trans  &trans  &kp F4   &kp F5  &kp F6  &trans  &trans
&trans  &trans  &trans    &trans         &trans   &trans  &trans  &trans  &trans  &kp F10  &kp F2  &kp F3  &trans  &trans
&trans  &trans  &trans    &trans         &trans   &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans            &trans            &trans            &trans            &trans                               &trans            &trans            &trans             &trans            &trans     &trans
&trans  &trans            &trans            &trans            &trans            &trans                               &trans            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH     &kp EQUAL  &trans
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &trans  &trans     &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)   &kp LS(NUMBER_9)  &kp MINUS  &trans
&trans  &trans            &trans            &trans            &trans            &trans            &trans  &trans     &trans            &kp JP_YEN        &kp JP_UNDERSCORE  &kp SEMICOLON     &kp APOS   &trans
&trans  &trans            &trans            &trans            &trans            &trans            &trans  &kp GRAVE  &trans            &trans            &trans             &trans            &trans     &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB5  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
            >;
        };
    };
};
